# Copy as .env (local) or configure in Vercel. NEVER commit real values.

# Payload auth secret (generate: openssl rand -hex 32)
PAYLOAD_SECRET=

# Postgres pooled connection (Neon in preview/production):
# postgres://user:pass@ep-xxxx.aws.neon.tech/borahae?sslmode=require
DATABASE_URL=

# Vercel Blob storage token (auto-injected by Vercel when the store is linked).
# In local development it stays empty: Media stores files on disk (src/media).
# BLOB_READ_WRITE_TOKEN=
